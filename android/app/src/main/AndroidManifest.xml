<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本机 HTTP 服务（只监听 127.0.0.1）和 Wiki 等线上链接要用网络 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wdfz"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <!-- 旋转、键盘、窗口大小变化都不重建 Activity：游戏不重新载入。
             默认横屏（左右两个方向都行，跟随系统的自动旋转锁）；游戏设置里关掉「自动横屏」后，页面通过本机服务让它跟随系统 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
